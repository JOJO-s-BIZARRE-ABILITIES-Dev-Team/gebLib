"screenspace_general"
{
    "$pixshader" "geblib_impact_ps20"
    "$basetexture" "_rt_FullFrameFB"
    "$texture1" "color/black"
    "$texture2" "color/black"

    "$x360appchooser" "1"
    "$ignorez" "1"
    "$fix_fb" "32768"
    "$copyalpha" "1"
    "$alpha_blend" "0"
    "$linearwrite" "0"
    "$linearread_basetexture" "0"
    "$linearread_texture1" "1"
    "$linearread_texture2" "1"

    "$c0_x" "1.0"
    "$c0_y" "0.0"
    "$c0_z" "0.0"
    "$c0_w" "0.0"
    "$c1_x" "0.5"
    "$c1_y" "0.5"
    "$c1_z" "1.0"
    "$c1_w" "0.0"
    "$c2_x" "1.0"
    "$c2_y" "1.0"
    "$c2_z" "1.0"
    "$c2_w" "0.0"
    "$c3_x" "0.0"
    "$c3_y" "0.0"
    "$c3_z" "0.0"
    "$c3_w" "0.0"

    "<dx90"
    {
        "$no_draw" "1"
    }

    "Proxies"
    {
        "Equals"
        {
            "srcVar1" "$fix_fb"
            "resultVar" "$flags2"
        }
    }
}
